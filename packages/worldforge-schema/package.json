{
  "name": "@worldforge/schema",
  "version": "0.1.0",
  "private": true,
  "description": "Engine-agnostic WorldForge manifest and changeset schemas.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "schema"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "schema": "npm run build && node scripts/generate-json-schema.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
