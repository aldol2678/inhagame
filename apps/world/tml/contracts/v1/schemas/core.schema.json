        "profile",
        "scope",
        "claim",
        "evidence",
        "status",
        "reason",
        "checkedAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SATISFIED"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "SETTLEMENT_MATCH",
                  "PROJECTION_APPLIED",
                  "AUTHORITATIVE_FACT_PRESENT",
                  "EXPLICIT_TRUE",
                  "AUTHORITATIVE_COMPARISON",
                  "AND_SATISFIED",
                  "OR_SATISFIED",
                  "NOT_SATISFIED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNSATISFIED"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "REWARD_VERSION_MISMATCH",
                  "REWARD_ID_MISMATCH",
                  "EFFECT_SET_MISMATCH",
                  "EFFECT_MISMATCH",
                  "AUTHORITATIVE_COMPARISON",
                  "AND_UNSATISFIED",
                  "OR_UNSATISFIED",
                  "NOT_UNSATISFIED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "UNTRUSTED_PROVENANCE",
                  "SNAPSHOT_INCOMPARABLE",
                  "STALE_SNAPSHOT",
                  "RECEIPT_MISSING",
                  "AUTHORITATIVE_FACT_MISSING",
                  "OBSERVATION_MISSING",
                  "EXECUTION_BINDING_MISSING",
                  "READ_UNAVAILABLE",
                  "EXECUTION_UNRESOLVED",
                  "RETENTION_EXPIRED",
                  "AND_UNKNOWN",
                  "OR_UNKNOWN",
                  "CLAIM_MISSING",
                  "EVIDENCE_MISSING"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "CONFLICT"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "RECEIPT_CONFLICT",
                  "AUTHORITATIVE_FACT_CONFLICT",
                  "AND_CONFLICT",
                  "OR_CONFLICT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "INVALID"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "INVALID_JSON",
                  "INVALID_UNICODE",
                  "DUPLICATE_KEY",
                  "SCHEMA_VIOLATION",
                  "INTEGER_RANGE",
                  "INTEGER_ENCODING",
                  "NUMBER_RANGE",
                  "NONFINITE_NUMBER",
                  "NUMBER_UNDERFLOW",
                  "TIME_ENCODING",
                  "TIME_PRECISION_UNSUPPORTED",
                  "LIMIT_EXCEEDED",
                  "SCOPE_MISMATCH",
                  "HASH_MISMATCH",
                  "PROFILE_MISMATCH",
                  "SNAPSHOT_MISMATCH",
                  "DUPLICATE_ENTRY",
                  "DUPLICATE_SET_MEMBER",
                  "DUPLICATE_RECORD",
                  "REFERENCE_MISMATCH",
                  "OPERAND_TYPE",
                  "REQUEST_MISMATCH",
                  "EXECUTION_BINDING_MISMATCH",
                  "IDEMPOTENCY_CONFLICT",
                  "RECEIPT_INTEGRITY",
                  "AUTHORIZATION_DENIED",
                  "HANDLE_EXPIRED",
                  "HANDLE_GENERATION_MISMATCH"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ERROR"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "INTERNAL_ERROR",
                  "INTEGER_OVERFLOW"
                ]
              }
            }
          }
        }
      ]
    },
