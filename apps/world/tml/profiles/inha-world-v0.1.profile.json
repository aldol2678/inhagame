{
  "schema": "tml.profile",
  "version": "0.1",
  "id": "inha.world@0.1",
  "entity_types": [
    "player",
    "npc",
    "quest",
    "building",
    "area",
    "item",
    "vehicle",
    "reward"
  ],
  "predicates": [
    "quest.stage",
    "quest.available",
    "location",
    "wallet.balance",
    "owns",
    "mounted_on",
    "npc.activity",
    "npc.relation",
    "progression.total_exp",
    "progression.level",
    "reward.status",
    "reward.granted",
    "reward.replayed"
  ],
  "events": [
    "world.quest.event",
    "player.entered_area",
    "npc.arrived"
  ],
  "capabilities": [
    {
      "id": "world.quest.advance",
      "mutates": true,
      "parameters": {
        "quest": {
          "type": "ref",
          "entity": "quest"
        },
        "event": {
          "type": "string"
        }
      },
      "provider_binding": "world.quest.store",
      "verification": {
        "predicate": "quest.stage",
        "authority": "server.quest"
      }
    },
    {
      "id": "world.quest.read",
      "mutates": false,
      "parameters": {
        "quest": {
          "type": "ref",
          "entity": "quest"
        }
      },
      "provider_binding": "world.quest.store"
    },
    {
      "id": "world.wallet.read",
      "mutates": false,
      "parameters": {}
    },
    {
      "id": "world.progression.read",
      "mutates": false,
      "parameters": {}
    }
  ],
  "authority": [
    {
      "predicate": "quest.stage",
      "authority": "server.quest",
      "fallback": [
        "world.client"
      ]
    },
    {
      "predicate": "quest.available",
      "authority": "server.quest",
      "fallback": [
        "world.client"
      ]
    },
    {
      "predicate": "wallet.balance",
      "authority": "server.wallet",
      "fallback": [
        "world.client"
      ]
    },
    {
      "predicate": "location",
      "authority": "world.client"
    },
    {
      "predicate": "mounted_on",
      "authority": "world.client"
    },
    {
      "predicate": "progression.total_exp",
      "authority": "server.progression"
    },
    {
      "predicate": "progression.level",
      "authority": "server.progression"
    },
    {
      "predicate": "reward.status",
      "authority": "server.reward"
    },
    {
      "predicate": "reward.granted",
      "authority": "server.reward"
    },
    {
      "predicate": "reward.replayed",
      "authority": "server.reward"
    }
  ],
  "extensions": {
    "status": "P1_PROFILE_CONTRACT",
    "public_repo": "aldol2678/inhagame",
    "notes": [
      "INHA WORLD-specific vocabulary belongs here, not in generic TML Core.",
      "Provider success does not imply verified state change.",
      "Mutating capability completion requires authoritative readback."
    ]
  }
}
