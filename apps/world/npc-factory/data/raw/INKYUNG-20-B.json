      "dialogue_hooks": {
        "morning": [
          "이 벤치에 앉으면 생각이 정리돼요. 짧은 글을 읽는 중이에요.",
          "아침 공기가 아직 차분하네요. 읽던 글 한 줄이 자꾸 떠올라요."
        ],
        "class_time": [
          "이 벤치가 오늘은 조용하네요. 커피가 아직 따뜻하네요.",
          "수업 시간에는 조금 조용해져요. 빛이 바뀌는 순간이 눈에 들어와요."
        ],
        "lunch": [
          "이제 본관 쪽으로 이동해요. 다음에 또 들를게요.",
          "점심에는 걸음이 느려지네요. 새로 배운 표현을 머릿속으로 되뇌어요."
        ],
        "evening": [
          "이제 학생회관 쪽으로 이동해요. 다음에 또 들를게요.",
          "저녁에는 말수가 줄어드는 편이에요. 읽던 글 한 줄이 자꾸 떠올라요."
        ]
      },
