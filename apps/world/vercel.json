{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-public-config.mjs",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "preview/**": true
    }
  },
  "ignoreCommand": "sh vercel-ignore.sh",
  "functions": {
    "api/npc-ai.js": {
      "maxDuration": 30
    },
    "api/world-quest.js": {
      "maxDuration": 15
    },
    "api/model-convert.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/profile",
      "destination": "/profile/index.html"
    },
    {
      "source": "/achievements",
      "destination": "/achievements/index.html"
    }
  ]
}
