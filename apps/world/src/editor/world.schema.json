{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inhagame.example/world-schema/0.1.0",
  "title": "INHA WORLD WorldDocument v0.1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "worldId",
    "name",
    "coordinateSystem",
    "assets",
    "entities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "worldId": {
      "$ref": "#/$defs/nonempty"
    },
    "name": {
      "$ref": "#/$defs/nonempty"
    },
    "coordinateSystem": {
      "type": "object",
      "required": [
        "handedness",
        "upAxis",
        "unit"
      ],
      "properties": {
        "handedness": {
          "const": "right"
        },
        "upAxis": {
          "const": "Y"
        },
        "unit": {
          "const": "meter"
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonempty": {
      "type": "string",
      "pattern": "\\S"
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "positiveVec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "quat": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "transform": {
      "type": "object",
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "$ref": "#/$defs/quat"
        },
        "scale": {
          "$ref": "#/$defs/positiveVec3"
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "type",
        "uri"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "type": {
          "enum": [
            "model",
            "texture",
            "audio",
            "other"
          ]
        },
        "uri": {
          "$ref": "#/$defs/nonempty"
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "parentId",
        "enabled",
        "transform",
        "tags",
        "components"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "name": {
          "$ref": "#/$defs/nonempty"
        },
        "kind": {
          "$ref": "#/$defs/nonempty"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonempty"
            },
            {
              "type": "null"
            }
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "components": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]*\\.[A-Za-z][A-Za-z0-9]*$"
          },
          "properties": {
            "core.renderable": {
              "type": "object",
              "required": [
                "assetId"
              ],
              "properties": {
                "assetId": {
                  "$ref": "#/$defs/nonempty"
                },
                "visible": {
                  "type": "boolean"
                },
                "castShadow": {
                  "type": "boolean"
                },
                "receiveShadow": {
                  "type": "boolean"
                }
              }
            },
            "world.building": {
              "type": "object",
              "dependentRequired": {
                "footprint": [
                  "heightMeters"
                ]
              },
              "properties": {
                "floors": {
                  "type": "integer",
                  "minimum": 1
                },
                "heightMeters": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "footprint": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 1000,
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "entrances": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "position"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/nonempty"
                      },
                      "position": {
                        "$ref": "#/$defs/vec3"
                      }
                    }
                  }
                }
              }
            },
            "world.path": {
              "type": "object",
              "required": [
                "pathType",
                "points",
                "widthMeters",
                "closed"
              ],
              "properties": {
                "pathType": {
                  "enum": [
                    "road",
                    "walkway",
                    "custom"
                  ]
                },
                "points": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "$ref": "#/$defs/vec3"
                  }
                },
                "widthMeters": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "closed": {
                  "type": "boolean"
                },
                "interpolation": {
                  "const": "catmull-rom"
                }
              }
            },
            "game.spawn": {
              "type": "object",
              "required": [
                "spawnType",
                "refId",
                "radiusMeters"
              ],
              "properties": {
                "spawnType": {
                  "enum": [
                    "player",
                    "npc",
                    "prop",
                    "custom"
                  ]
                },
                "refId": {
                  "$ref": "#/$defs/nonempty"
                },
                "radiusMeters": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "game.trigger": {
              "type": "object",
              "required": [
                "triggerType",
                "refId",
                "shape"
              ],
              "properties": {
                "triggerType": {
                  "$ref": "#/$defs/nonempty"
                },
                "refId": {
                  "$ref": "#/$defs/nonempty"
                },
                "shape": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "size"
                      ],
                      "properties": {
                        "type": {
                          "const": "box"
                        },
                        "size": {
                          "$ref": "#/$defs/positiveVec3"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "radius"
                      ],
                      "properties": {
                        "type": {
                          "const": "sphere"
                        },
                        "radius": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    }
                  ]
                }
              }
            },
            "world.structure": {
              "type": "object",
              "required": [
                "shape",
                "sizeMeters"
              ],
              "properties": {
                "shape": {
                  "const": "box"
                },
                "sizeMeters": {
                  "$ref": "#/$defs/positiveVec3"
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": {
            "type": "object"
          }
        },
        "metadata": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
