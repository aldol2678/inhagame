FROM node:22-bookworm-slim

# Blender's glTF exporter imports numpy at export time; --no-install-recommends
# drops it, so python3-numpy must be listed explicitly (see convert-model.mjs).
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends blender python3-numpy ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY model-converter ./model-converter

ENV PORT=8080
CMD ["node", "model-converter/cloud-run.mjs"]
